# ── Supabase (สร้างโปรเจกต์ฟรีที่ https://supabase.com แล้ว Project Settings → API) ──
# ใส่ค่าแล้ว rename เป็น .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Supabase → Project Settings → Database → Connection string → URI) ──
# เลือกช่อง Transaction pooler (port 6543) สำหรับ Next.js
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ── โหมดสาธิต: ถ้าไม่กรอกค่าด้านบน แอปจะรันโหมด demo (ข้อมูลจำลอง ไม่ต้องมีฐานข้อมูล) ──
# กรอกค่า Supabase แล้วรัน: npm run db:push && npm run db:seed แล้วรีสตาร์ท dev server

# ── หลังบ้านแอดมิน (/admin) ──
# ลายเซ็น session แอดมิน: สุ่มอย่างน้อย 32 ตัวอักษร (โหมดจริงถ้าไม่ตั้ง ระบบแอดมินจะปิด)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# บัญชีแอดมิน: email|role|salt:hash  คั่นหลายบัญชีด้วย ;   role = super | finance | cs | kyc
#   สร้าง salt:hash ด้วย  npm run admin:hash -- "รหัสผ่านที่ต้องการ"
ADMIN_ACCOUNTS=
# โหมดสาธิตเท่านั้น (ไม่มี DATABASE_URL และไม่ได้ตั้ง ADMIN_ACCOUNTS):
#   บัญชี super@mord.demo / finance@mord.demo / cs@mord.demo / kyc@mord.demo ใช้รหัสนี้ (ค่าเริ่มต้น mord-demo)
ADMIN_DEMO_PASSWORD=mord-demo

# ── หน้ารับสมัครหมอ /join (Supabase แยกสำหรับผู้สมัคร) ──
# รัน supabase/join/0001_applicants.sql แล้วสร้าง Storage bucket "applicants" แบบ Private
SUPABASE_URL=
# (ใช้ SUPABASE_SERVICE_ROLE_KEY ด้านบนร่วมกัน)

# ── Google Sheet ผ่าน Apps Script (google-apps-script.gs) ──
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# ── QR พร้อมเพย์ฝังยอด (ว่าง = ใช้ค่าที่ตั้งใน src/lib/join/config.ts) ──
NEXT_PUBLIC_PROMPTPAY_ID=

# ── อีเมลแจ้งเตือน (Resend https://resend.com) — ว่าง = ไม่ส่ง (log อย่างเดียว) ──
RESEND_API_KEY=
EMAIL_FROM=Mister Bamrungsuk <noreply@misterbamrungsuk.com>
# อีเมลแอดมินรับแจ้งผู้สมัครใหม่ (คั่นหลายอีเมลด้วย ,)
ADMIN_NOTIFY_EMAIL=

# ── สำรองข้อมูลรายวัน (Vercel Cron → /api/cron/backup → Apps Script → Drive "MB Backups") ──
# สุ่มค่ายาว ๆ แล้วตั้งใน Vercel env ด้วย (Vercel ส่ง Authorization: Bearer CRON_SECRET ให้อัตโนมัติ)
CRON_SECRET=
